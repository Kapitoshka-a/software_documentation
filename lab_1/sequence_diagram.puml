@startuml
actor "Client" as Client
participant "System" as System
actor "Operator 1" as Op1
actor "Operator 2" as Op2

Client -> System: Create request
activate System
System -> Op1: Assign Conversation
activate Op1
Op1 -> Client: Reply to client
Op1 -> System: Request transfer to another operator
System -> Op2: Assign Conversation
deactivate Op1
activate Op2
Op2 -> Client: Resolve issue
Op2 -> System: Close Conversation
deactivate Op2
System -> Client: Resolution notification
deactivate System
@enduml